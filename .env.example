# Copy this file to server/.env. Never commit real credentials.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/chaselist?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Private AWS S3 storage. Use the AWS SDK credential chain/IAM role in production.
AWS_REGION=us-east-1
S3_BUCKET=your-private-chaselist-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional S3-compatible endpoint for local development only (for example MinIO).
# S3_ENDPOINT=
